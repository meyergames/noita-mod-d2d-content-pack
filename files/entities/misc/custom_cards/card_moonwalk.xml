<Entity tags="card_action">

    <Base file="data/entities/base_custom_card.xml" >
        <SpriteComponent 
            image_file="mods/D2DContentPack/files/gfx/ui_gfx/spells/moonwalk.png" >
        </SpriteComponent>

        <ItemActionComponent 
            _tags="enabled_in_world"
            action_id="D2D_MOONWALK" >
        </ItemActionComponent>
    </Base>

    <InheritTransformComponent
        _tags="enabled_in_world,enabled_in_hand" >
      <Transform 
        position.x="8" 
        position.y="0" >
      </Transform>
    </InheritTransformComponent>

    <LuaComponent
        _tags="enabled_in_hand"
        script_source_file="mods/D2DContentPack/files/scripts/projectiles/moonwalk_update.lua"
        execute_every_n_frame="1"
    ></LuaComponent>

    <LuaComponent
        _tags="enabled_in_inventory,enabled_in_world"
        script_source_file="mods/D2DContentPack/files/scripts/projectiles/moonwalk_reset.lua"
        execute_every_n_frame="6"
    ></LuaComponent>
  
    <ParticleEmitterComponent
        _tags="enabled_in_hand,enabled_in_world"
        emitted_material_name="spark_white"
        gravity.y="0.0"
        lifetime_min="0.25"
        lifetime_max="0.5"
        count_min="2"
        count_max="4"
        render_on_grid="1"
        fade_based_on_lifetime="1"
        area_circle_radius.max="28"
        cosmetic_force_create="0"
        airflow_force="0.1"
        airflow_time="0.01"
        airflow_scale="0.05"
        emission_interval_min_frames="6"
        emission_interval_max_frames="10"
        emit_cosmetic_particles="1"
        is_emitting="1" >
    </ParticleEmitterComponent>

</Entity>